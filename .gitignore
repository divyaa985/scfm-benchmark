__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Data and model weights are never committed, but the folder note is
data/*
!data/README.md
*.h5ad
*.ckpt
*.pt
*.safetensors

# Results: summaries are committed, everything else is not
results/*
!results/.gitkeep
!results/*_summary.md
!results/*_summary.csv
!results/*_folds.csv
!results/*_per_class.csv
!results/*_confusion.csv
!results/figures/
!results/figures/*.png

.env
.DS_Store
